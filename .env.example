# Web
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SERVER_URL="http://localhost:4000"

# Auth
# Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
