# Server
PORT="4000"
# Comma-separated list is supported for deploy previews.
CLIENT_ORIGIN="http://localhost:3000"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/deuces_arena"
PUSH_NOTIFICATIONS_ENABLED="false"
EXPO_ACCESS_TOKEN=""

# Future realtime scaling
REDIS_URL=""

# ML / data export
COACH_EVALUATION_EXPORT_PATH="artifacts/coach-evaluations.jsonl"
COACH_EVALUATION_EXPORT_LIMIT="1000"

# Payments are intentionally deferred.
STRIPE_SECRET_KEY=""
