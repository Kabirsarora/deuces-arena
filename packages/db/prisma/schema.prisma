generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MatchMode {
  CASUAL
  RANKED
  TOURNAMENT
  LOCAL_DEMO
}

enum MatchStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum TournamentStatus {
  SEMIFINALS
  FINAL
  COMPLETED
  ABANDONED
}

enum TournamentStage {
  SEMIFINAL_A
  SEMIFINAL_B
  FINAL
}

enum PlayerKind {
  HUMAN
  BOT
  GUEST
}

enum MoveKind {
  PLAY
  PASS
}

enum CosmeticKind {
  CARD_BACK
  TABLE_THEME
  AVATAR
  PROFILE_BORDER
  EMOTE
  WIN_ANIMATION
}

enum CosmeticUnlockSource {
  EARNED
  SUPPORTER
  PROMOTIONAL
  ADMIN_GRANT
}

enum PlayerReportReason {
  HARASSMENT
  HATE_SPEECH
  SPAM
  CHEATING
  INAPPROPRIATE_NAME
  OTHER
}

enum PlayerReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
}

model User {
  id                String                  @id @default(cuid())
  username          String                  @unique
  guestId           String?                 @unique
  email             String?                 @unique
  displayName       String?
  avatarKey         String                  @default("diamond")
  imageUrl          String?
  rating            Int                     @default(1000)
  gamesPlayed       Int                     @default(0)
  wins              Int                     @default(0)
  losses            Int                     @default(0)
  placementTotal    Int                     @default(0)
  arenaCoins        Int                     @default(0)
  supporterStatus   String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  matchPlayers      MatchPlayer[]
  cosmeticUnlocks   UserCosmeticUnlock[]
  equippedCosmetics UserEquippedCosmetic[]
  oauthAccounts     OAuthAccount[]
  feedbackReports   FeedbackReport[]
  replayLabels      ReplayLabel[]
  blocksCreated     UserBlock[]             @relation("Blocker")
  blocksReceived    UserBlock[]             @relation("Blocked")
  reportsSubmitted  PlayerReport[]          @relation("Reporter")
  reportsReceived   PlayerReport[]          @relation("Reported")
  tournamentEntries TournamentParticipant[]
  tournamentWins    Tournament[]            @relation("TournamentChampion")
  pushSubscriptions PushSubscription[]

  @@index([rating])
}

model PushSubscription {
  id              String               @id @default(cuid())
  userId          String
  expoPushToken   String               @unique
  platform        String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  lastSeenAt      DateTime             @default(now())
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryTickets PushDeliveryTicket[]

  @@index([userId])
}

model PushDeliveryTicket {
  id             String           @id @default(cuid())
  subscriptionId String
  receiptId      String           @unique
  createdAt      DateTime         @default(now())
  checkedAt      DateTime?
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([checkedAt, createdAt])
  @@index([subscriptionId])
}

model UserBlock {
  id            String   @id @default(cuid())
  blockerUserId String
  blockedUserId String
  createdAt     DateTime @default(now())
  blocker       User     @relation("Blocker", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked       User     @relation("Blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerUserId, blockedUserId])
  @@index([blockedUserId])
}

model PlayerReport {
  id              String             @id @default(cuid())
  reporterUserId  String?
  reportedUserId  String?
  reporterGuestId String?
  reportedGuestId String?
  roomCode        String?
  messageId       String?
  messageBody     String?
  reason          PlayerReportReason
  details         String?
  status          PlayerReportStatus @default(OPEN)
  createdAt       DateTime           @default(now())
  reporter        User?              @relation("Reporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  reported        User?              @relation("Reported", fields: [reportedUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([reportedUserId, status])
  @@index([reportedGuestId, status])
  @@index([roomCode])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  displayName       String?
  imageUrl          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([email])
}

model Match {
  id               String            @id @default(cuid())
  mode             MatchMode         @default(CASUAL)
  status           MatchStatus       @default(IN_PROGRESS)
  roomCode         String?
  seed             String?
  startedAt        DateTime          @default(now())
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  players          MatchPlayer[]
  moves            MoveEvent[]
  coachEvaluations CoachEvaluation[]
  replayLabels     ReplayLabel[]
  tournamentId     String?
  tournamentStage  TournamentStage?
  tournament       Tournament?       @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, tournamentStage])
  @@index([mode, status])
  @@index([startedAt])
}

model Tournament {
  id             String                  @id @default(cuid())
  publicId       String                  @unique
  status         TournamentStatus        @default(SEMIFINALS)
  championUserId String?
  championName   String?
  createdAt      DateTime                @default(now())
  completedAt    DateTime?
  updatedAt      DateTime                @updatedAt
  champion       User?                   @relation("TournamentChampion", fields: [championUserId], references: [id], onDelete: SetNull)
  participants   TournamentParticipant[]
  matches        Match[]

  @@index([status, createdAt])
  @@index([championUserId])
}

model TournamentParticipant {
  id                 String          @id @default(cuid())
  tournamentId       String
  userId             String?
  guestId            String
  playerName         String
  seed               Int
  semifinalStage     TournamentStage
  semifinalPlacement Int?
  advancedToFinal    Boolean         @default(false)
  finalPlacement     Int?
  createdAt          DateTime        @default(now())
  tournament         Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user               User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, guestId])
  @@unique([tournamentId, seed])
  @@index([userId, createdAt])
  @@index([tournamentId, finalPlacement])
}

model MatchPlayer {
  id               String            @id @default(cuid())
  matchId          String
  userId           String?
  playerSeat       Int
  playerLabel      String
  kind             PlayerKind
  placement        Int?
  ratingBefore     Int?
  ratingAfter      Int?
  cardsRemaining   Int?
  bombsPlayed      Int               @default(0)
  averageMoveCount Int?
  match            Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  moves            MoveEvent[]
  coachEvaluations CoachEvaluation[]

  @@unique([matchId, playerSeat])
  @@index([userId])
  @@index([matchId])
}

model MoveEvent {
  id                   String      @id @default(cuid())
  matchId              String
  matchPlayerId        String
  turnNumber           Int
  kind                 MoveKind
  handType             String?
  cards                Json
  handBefore           Json
  legalMoves           Json?
  currentTrickBefore   Json?
  cardsRemainingBefore Json
  cardsRemainingAfter  Json
  gameResult           Json?
  placement            Int?
  winProbability       Float?
  simulationScore      Float?
  modelScore           Float?
  createdAt            DateTime    @default(now())
  match                Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchPlayer          MatchPlayer @relation(fields: [matchPlayerId], references: [id], onDelete: Cascade)

  @@unique([matchId, turnNumber])
  @@index([matchPlayerId])
  @@index([matchId, turnNumber])
}

model CoachEvaluation {
  id                 String      @id @default(cuid())
  matchId            String
  matchPlayerId      String
  roomCode           String?
  playerId           String
  playerLabel        String
  turnNumber         Int
  handBefore         Json
  currentTrickBefore Json?
  evaluations        Json
  rolloutsPerMove    Int
  evaluatedMoveCount Int
  createdAt          DateTime    @default(now())
  match              Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchPlayer        MatchPlayer @relation(fields: [matchPlayerId], references: [id], onDelete: Cascade)

  @@index([matchId, turnNumber])
  @@index([matchPlayerId])
  @@index([roomCode, createdAt])
}

model ReplayLabel {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  label     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId, label])
  @@index([matchId])
  @@index([userId, createdAt])
}

model Cosmetic {
  id          String                 @id @default(cuid())
  slug        String                 @unique
  kind        CosmeticKind
  name        String
  description String?
  rarity      String                 @default("common")
  isSupporter Boolean                @default(false)
  coinPrice   Int?
  isActive    Boolean                @default(true)
  previewUrl  String?
  metadata    Json?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  unlocks     UserCosmeticUnlock[]
  equippedBy  UserEquippedCosmetic[]

  @@index([kind, isActive])
  @@index([isSupporter])
}

model UserCosmeticUnlock {
  id         String               @id @default(cuid())
  userId     String
  cosmeticId String
  source     CosmeticUnlockSource @default(EARNED)
  earnedAt   DateTime             @default(now())
  metadata   Json?
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmetic   Cosmetic             @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  @@unique([userId, cosmeticId])
  @@index([cosmeticId])
  @@index([userId, source])
}

model UserEquippedCosmetic {
  id         String       @id @default(cuid())
  userId     String
  cosmeticId String
  kind       CosmeticKind
  equippedAt DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmetic   Cosmetic     @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([cosmeticId])
}

model FeedbackReport {
  id           String   @id @default(cuid())
  userId       String?
  guestId      String?
  roomCode     String?
  kind         String
  body         String
  contactEmail String?
  userAgent    String?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([guestId])
  @@index([roomCode])
  @@index([kind])
}
