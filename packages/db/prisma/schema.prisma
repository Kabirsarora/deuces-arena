generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MatchMode {
  CASUAL
  RANKED
  LOCAL_DEMO
}

enum MatchStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum PlayerKind {
  HUMAN
  BOT
  GUEST
}

enum MoveKind {
  PLAY
  PASS
}

enum CosmeticKind {
  CARD_BACK
  TABLE_THEME
  AVATAR
  PROFILE_BORDER
  EMOTE
  WIN_ANIMATION
}

enum CosmeticUnlockSource {
  EARNED
  SUPPORTER
  PROMOTIONAL
  ADMIN_GRANT
}

model User {
  id              String        @id @default(cuid())
  username        String        @unique
  guestId         String?       @unique
  email           String?       @unique
  displayName     String?
  avatarKey       String        @default("diamond")
  imageUrl        String?
  rating          Int           @default(1000)
  gamesPlayed     Int           @default(0)
  wins            Int           @default(0)
  losses          Int           @default(0)
  placementTotal  Int           @default(0)
  supporterStatus String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  matchPlayers    MatchPlayer[]
  cosmeticUnlocks UserCosmeticUnlock[]
  equippedCosmetics UserEquippedCosmetic[]
  oauthAccounts   OAuthAccount[]

  @@index([rating])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  displayName       String?
  imageUrl          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([email])
}

model Match {
  id          String        @id @default(cuid())
  mode        MatchMode     @default(CASUAL)
  status      MatchStatus   @default(IN_PROGRESS)
  roomCode    String?
  seed        String?
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  players     MatchPlayer[]
  moves       MoveEvent[]
  coachEvaluations CoachEvaluation[]

  @@index([mode, status])
  @@index([startedAt])
}

model MatchPlayer {
  id               String      @id @default(cuid())
  matchId          String
  userId           String?
  playerSeat       Int
  playerLabel      String
  kind             PlayerKind
  placement        Int?
  ratingBefore     Int?
  ratingAfter      Int?
  cardsRemaining   Int?
  bombsPlayed      Int         @default(0)
  averageMoveCount Int?
  match            Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user             User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  moves            MoveEvent[]
  coachEvaluations CoachEvaluation[]

  @@unique([matchId, playerSeat])
  @@index([userId])
  @@index([matchId])
}

model MoveEvent {
  id                   String      @id @default(cuid())
  matchId              String
  matchPlayerId        String
  turnNumber           Int
  kind                 MoveKind
  handType             String?
  cards                Json
  handBefore           Json
  legalMoves           Json?
  currentTrickBefore   Json?
  cardsRemainingBefore Json
  cardsRemainingAfter  Json
  gameResult           Json?
  placement            Int?
  winProbability       Float?
  simulationScore      Float?
  modelScore           Float?
  createdAt            DateTime    @default(now())
  match                Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchPlayer          MatchPlayer @relation(fields: [matchPlayerId], references: [id], onDelete: Cascade)

  @@unique([matchId, turnNumber])
  @@index([matchPlayerId])
  @@index([matchId, turnNumber])
}

model CoachEvaluation {
  id                 String      @id @default(cuid())
  matchId            String
  matchPlayerId      String
  roomCode           String?
  playerId           String
  playerLabel        String
  turnNumber         Int
  handBefore         Json
  currentTrickBefore Json?
  evaluations        Json
  rolloutsPerMove    Int
  evaluatedMoveCount Int
  createdAt          DateTime    @default(now())
  match              Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchPlayer        MatchPlayer @relation(fields: [matchPlayerId], references: [id], onDelete: Cascade)

  @@index([matchId, turnNumber])
  @@index([matchPlayerId])
  @@index([roomCode, createdAt])
}

model Cosmetic {
  id          String         @id @default(cuid())
  slug        String         @unique
  kind        CosmeticKind
  name        String
  description String?
  rarity      String         @default("common")
  isSupporter Boolean        @default(false)
  isActive    Boolean        @default(true)
  previewUrl  String?
  metadata    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  unlocks     UserCosmeticUnlock[]
  equippedBy  UserEquippedCosmetic[]

  @@index([kind, isActive])
  @@index([isSupporter])
}

model UserCosmeticUnlock {
  id          String               @id @default(cuid())
  userId      String
  cosmeticId  String
  source      CosmeticUnlockSource @default(EARNED)
  earnedAt    DateTime             @default(now())
  metadata    Json?
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmetic    Cosmetic             @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  @@unique([userId, cosmeticId])
  @@index([cosmeticId])
  @@index([userId, source])
}

model UserEquippedCosmetic {
  id          String       @id @default(cuid())
  userId      String
  cosmeticId  String
  kind        CosmeticKind
  equippedAt  DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmetic    Cosmetic     @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([cosmeticId])
}
