# Server runtime
PORT="4000"
CLIENT_ORIGIN="http://localhost:3000"
DISCONNECTED_AUTO_MOVE_DELAY_MS="15000"

# Server-only account bridge. Use the same generated value on the web app.
REALTIME_AUTH_SECRET=""

# Optional creator/admin cosmetic access. Prefer ADMIN_EMAILS for signed-in admins.
# Use comma-separated values for multiple entries.
ADMIN_EMAILS=""
ADMIN_GUEST_IDS=""

# PostgreSQL persistence
# Leave empty for local in-memory fallback mode.
DATABASE_URL=""

# Mobile table alerts remain off until EAS push credentials are configured and device-tested.
PUSH_NOTIFICATIONS_ENABLED="false"
# Optional after enhanced Expo push security is enabled in the EAS dashboard.
EXPO_ACCESS_TOKEN=""

# Future scaling, not required for the current single-process demo.
REDIS_URL=""
